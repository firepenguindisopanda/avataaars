{
  "name": "@firepenguindisopanda/avataaars",
  "version": "2.5.2",
  "type": "module",
  "description": "React component for avataaars. Fork of @gschoppe/avataaars with upstream-compatible default options and a dual ESM/CJS build.",
  "keywords": [
    "react",
    "avatar",
    "avataaars",
    "svg",
    "avatar-generator"
  ],
  "homepage": "https://github.com/firepenguindisopanda/avataaars#readme",
  "bugs": {
    "url": "https://github.com/firepenguindisopanda/avataaars/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firepenguindisopanda/avataaars.git"
  },
  "license": "MIT",
  "author": "firepenguindisopanda (https://github.com/firepenguindisopanda)",
  "contributors": [
    "Pablo Stanley (original artwork, https://avataaars.com)",
    "Fang-Pen Lin (original React port, https://github.com/fangpenlin/avataaars)",
    "Greg Schoppe (React 19 support and new options, https://github.com/gschoppe/avataaars)"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/animations.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./animations.css": "./dist/animations.css",
    "./dist/animations.css": "./dist/animations.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist/",
    "copy-styles": "copyfiles -u 1 src/*.css dist/",
    "build": "tsup && npm run copy-styles"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "copyfiles": "^2.4.1",
    "import-sort-style-renke": "^6.0.0",
    "rimraf": "^6.0.1",
    "tslint": "^6.1.3",
    "tslint-config-standard": "^9.0.0",
    "tslint-react": "^5.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "importSort": {
    ".js, .jsx, .es6, .es": {
      "parser": "babylon",
      "style": "import-sort-style-renke"
    },
    ".ts, .tsx": {
      "parser": "typescript",
      "style": "import-sort-style-renke"
    }
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "jsxBracketSameLine": true
  }
}
